{
  "name": "unteam",
  "version": "0.1.0",
  "description": "CLI host for the local unteam synthetic emulator",
  "license": "Apache-2.0",
  "bin": {
    "unteam": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "bun run --cwd ../.. build:executable && bunx --bun vitest run"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:effect",
    "@unteam/emulator-bun": "workspace:*",
    "effect": "catalog:effect"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:effect",
    "@types/bun": "1.3.14",
    "typescript": "catalog:typescript",
    "vitest": "catalog:testing"
  }
}
