{
  "name": "@unteam/emulator-bun",
  "version": "0.1.0",
  "description": "Scoped Effect Platform Bun HTTP host for the unteam emulator",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@unteam/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "@unteam/source": "./src/server.layer.ts",
      "types": "./dist/server.layer.d.ts",
      "default": "./dist/server.layer.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "@unteam/source": "./src/index.ts",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./server": {
        "@unteam/source": "./src/server.layer.ts",
        "types": "./dist/server.layer.d.ts",
        "default": "./dist/server.layer.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "bun run test:fast && bun run test:server",
    "test:fast": "vitest run --exclude test/server.test.ts --passWithNoTests",
    "test:server": "bunx --bun vitest run test/server.test.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:effect",
    "@unteam/emulator-core": "workspace:*",
    "effect": "catalog:effect"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:effect",
    "@types/bun": "1.3.14",
    "typescript": "catalog:typescript",
    "vitest": "catalog:testing"
  }
}
