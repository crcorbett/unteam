{
  "name": "@unteam/emulator-core",
  "version": "0.2.0",
  "description": "Strict Effect synthetic multi-tenant Bot Connector emulator core",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@unteam/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "@unteam/source": "./src/schemas.ts",
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    },
    "./errors": {
      "@unteam/source": "./src/errors.ts",
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./service": {
      "@unteam/source": "./src/service.ts",
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    },
    "./live": {
      "@unteam/source": "./src/live.layer.ts",
      "types": "./dist/live.layer.d.ts",
      "default": "./dist/live.layer.js"
    },
    "./test": {
      "@unteam/source": "./src/test.layer.ts",
      "types": "./dist/test.layer.d.ts",
      "default": "./dist/test.layer.js"
    },
    "./fixtures": {
      "@unteam/source": "./src/fixtures.ts",
      "types": "./dist/fixtures.d.ts",
      "default": "./dist/fixtures.js"
    },
    "./observations": {
      "@unteam/source": "./src/observations.ts",
      "types": "./dist/observations.d.ts",
      "default": "./dist/observations.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "@unteam/source": "./src/index.ts",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./schemas": {
        "@unteam/source": "./src/schemas.ts",
        "types": "./dist/schemas.d.ts",
        "default": "./dist/schemas.js"
      },
      "./errors": {
        "@unteam/source": "./src/errors.ts",
        "types": "./dist/errors.d.ts",
        "default": "./dist/errors.js"
      },
      "./service": {
        "@unteam/source": "./src/service.ts",
        "types": "./dist/service.d.ts",
        "default": "./dist/service.js"
      },
      "./live": {
        "@unteam/source": "./src/live.layer.ts",
        "types": "./dist/live.layer.d.ts",
        "default": "./dist/live.layer.js"
      },
      "./test": {
        "@unteam/source": "./src/test.layer.ts",
        "types": "./dist/test.layer.d.ts",
        "default": "./dist/test.layer.js"
      },
      "./fixtures": {
        "@unteam/source": "./src/fixtures.ts",
        "types": "./dist/fixtures.d.ts",
        "default": "./dist/fixtures.js"
      },
      "./observations": {
        "@unteam/source": "./src/observations.ts",
        "types": "./dist/observations.d.ts",
        "default": "./dist/observations.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "effect": "catalog:effect"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:effect",
    "typescript": "catalog:typescript",
    "vitest": "catalog:testing"
  }
}
