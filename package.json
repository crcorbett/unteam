{
  "name": "unteam",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalogs": {
      "effect": {
        "effect": "4.0.5",
        "@effect/platform-bun": "4.0.5",
        "@effect/vitest": "4.0.5"
      },
      "typescript": {
        "typescript": "7.0.2"
      },
      "testing": {
        "vitest": "5.0.5"
      }
    }
  },
  "type": "module",
  "scripts": {
    "format:check": "oxfmt --check .",
    "format": "oxfmt .",
    "lint": "bun update @commonplaces/oxlint-plugin --latest --no-save --no-cache --ignore-scripts && effect-tsgo patch --oxlint && oxlint --type-aware --deny-warnings .",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "build": "turbo run build",
    "build:executable": "bun build --compile --conditions=@unteam/source apps/cli/src/main.ts --outfile artifacts/unteam && if [ \"$(uname -s)\" = Darwin ]; then codesign --force --sign - artifacts/unteam; fi",
    "knip": "knip --no-config-hints",
    "knip:production": "knip --production --config knip.production.ts --strict --no-config-hints",
    "test:exports": "python3 scripts/validate_packages.py .",
    "validate:repository": "python3 scripts/validate_repository.py .",
    "validate:governance": "python3 tools/governance/validate.py .",
    "docs:check": "python3 tools/governance/validate.py .",
    "test:packed": "bun run scripts/packed-artifact-proof.ts",
    "verification": "bun run format:check && bun run lint && bun run check-types && bun run knip && bun run knip:production && bun run test && bun run build && bun run build:executable && bun run test:exports && bun run validate:repository && bun run validate:governance && bun run test:packed",
    "prepare": "effect-tsgo patch --oxlint"
  },
  "devDependencies": {
    "@commonplaces/oxlint-plugin": "latest",
    "@effect/tsgo": "0.56.0",
    "@types/bun": "1.4.3",
    "effect": "catalog:effect",
    "knip": "6.42.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "turbo": "2.11.10",
    "typescript": "catalog:typescript"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.5"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.3"
}
